# Release build and TestFlight upload. One lane for CI (.github/workflows/release.yml) and the owner's Mac:
#   bundle exec fastlane ios beta                 # version from version.txt, build number = commit count
#   bundle exec fastlane ios beta upload:false    # archive and sign only (checks signing without uploading)
#
# Credentials come from the environment, never from the repo:
#   ASC_KEY_ID, ASC_ISSUER_ID               App Store Connect API key ids
#   ASC_KEY_P8 or ASC_KEY_PATH              the key itself (CI) or its file (default ~/.appstoreconnect/private_keys/AuthKey_<id>.p8)
#   DIST_CERT_P12_BASE64, DIST_CERT_P12_PASSWORD
#                                           Apple Distribution identity; CI only. Locally the login keychain has it.
# Optional:
#   VERSION                                 marketing version (release-please sets it; default version.txt)
#   BUILD_NUMBER                            default `git rev-list --count HEAD`; must beat every earlier upload of the version
#   TESTFLIGHT_GROUPS                       comma-separated external groups: distribute and submit for Beta App Review
#   TESTFLIGHT_CHANGELOG                    "What to Test" text (release notes in CI)
# On a Mac, ASC_KEY_ID and ASC_ISSUER_ID are read from ~/.appstoreconnect/openefb.env when they aren't set.

require "base64"
require "tmpdir"

default_platform(:ios)
skip_docs

PROJECT = "efb-212.xcodeproj".freeze
SCHEME = "efb-212".freeze
APP_TARGET = "efb-212".freeze
BUNDLE_ID = "io.omer.efb".freeze
TEAM_ID = "6F8N897928".freeze
PROFILE_NAME = "io.omer.efb AppStore".freeze
ROOT = File.expand_path("..", __dir__)
OUTPUT_DIR = File.join(ROOT, "build/release")

def load_local_asc_env
  env_file = File.expand_path("~/.appstoreconnect/openefb.env")
  return if ENV["ASC_KEY_ID"] || !File.exist?(env_file)

  File.foreach(env_file) do |line|
    next unless line.chomp =~ /\A\s*(?:export\s+)?(ASC_[A-Z_]+)=(.*)\z/

    ENV[Regexp.last_match(1)] ||= Regexp.last_match(2).strip.delete(%q("'))
  end
end

def asc_api_key
  load_local_asc_env
  key_id = ENV.fetch("ASC_KEY_ID") { UI.user_error!("ASC_KEY_ID is not set") }
  issuer_id = ENV.fetch("ASC_ISSUER_ID") { UI.user_error!("ASC_ISSUER_ID is not set") }
  if ENV["ASC_KEY_P8"].to_s.empty?
    path = ENV["ASC_KEY_PATH"] || File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    UI.user_error!("API key file not found: #{path}") unless File.exist?(path)
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: path)
  else
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_content: ENV["ASC_KEY_P8"])
  end
end

# CI: a throwaway keychain holding the distribution identity from the secrets.
def import_distribution_identity
  return if ENV["DIST_CERT_P12_BASE64"].to_s.empty?

  setup_ci(force: true)
  Dir.mktmpdir do |dir|
    p12 = File.join(dir, "distribution.p12")
    File.binwrite(p12, Base64.decode64(ENV["DIST_CERT_P12_BASE64"]))
    import_certificate(
      certificate_path: p12,
      certificate_password: ENV.fetch("DIST_CERT_P12_PASSWORD", ""),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
  end
end

def marketing_version
  version = ENV["VERSION"].to_s.strip
  version = File.read(File.join(ROOT, "version.txt")).strip if version.empty?
  UI.user_error!("marketing version '#{version}' must be 1 to 3 integers, like 1.2.0") unless version.match?(/\A\d+(\.\d+){0,2}\z/)
  version
end

def build_number
  number = ENV["BUILD_NUMBER"].to_s.strip
  number = sh("git", "-C", ROOT, "rev-list", "--count", "HEAD", log: false).strip if number.empty?
  UI.user_error!("build number '#{number}' is not an integer") unless number.match?(/\A\d+\z/)
  number
end

def testflight_groups
  raw = ENV["TESTFLIGHT_GROUPS"].to_s
  groups = raw.split(",").map(&:strip).reject(&:empty?)
  UI.user_error!("TESTFLIGHT_GROUPS ('#{raw}') names no group") if groups.empty? && !raw.strip.empty?
  groups
end

# A mistyped group would upload and submit for review without reaching any tester, so check names up front.
def verify_external_groups(groups)
  return if groups.empty?

  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID) || UI.user_error!("No App Store Connect app for #{BUNDLE_ID}")
  external = app.get_beta_groups.reject(&:is_internal_group).map(&:name)
  missing = groups - external
  UI.user_error!("TESTFLIGHT_GROUPS: no external group named #{missing.join(', ')} (external groups: #{external.join(', ')})") unless missing.empty?
end

platform :ios do
  desc "Archive a Release build and upload it to TestFlight (upload:false stops after signing)"
  lane :beta do |options|
    api_key = asc_api_key
    import_distribution_identity
    version = marketing_version
    build = build_number
    groups = testflight_groups
    UI.message("Kanaf #{version} (#{build})#{groups.empty? ? '' : ", external groups: #{groups.join(', ')}"}")
    verify_external_groups(groups) unless options[:upload].to_s == "false"

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      provisioning_name: PROFILE_NAME,
      ignore_profiles_with_different_name: true,
      output_path: OUTPUT_DIR
    )
    # sigh renames a profile it had to recreate (the old name stays taken), so sign with the name it installed.
    profile_name = lane_context[SharedValues::SIGH_NAME] || PROFILE_NAME

    # The project signs automatically for development. Release archives sign manually with the distribution
    # identity; the project file is restored afterwards so a local run leaves the checkout unchanged.
    pbxproj = File.join(ROOT, PROJECT, "project.pbxproj")
    original = File.read(pbxproj)
    begin
      update_code_signing_settings(
        path: File.join(ROOT, PROJECT),
        use_automatic_signing: false,
        targets: [APP_TARGET],
        build_configurations: ["Release"],
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name
      )
      build_app(
        project: File.join(ROOT, PROJECT),
        scheme: SCHEME,
        configuration: "Release",
        destination: "generic/platform=iOS",
        clean: true,
        output_directory: OUTPUT_DIR,
        output_name: "Kanaf-#{version}-#{build}.ipa",
        include_symbols: true,
        xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}",
        export_method: "app-store",
        export_options: {
          teamID: TEAM_ID,
          signingStyle: "manual",
          signingCertificate: "Apple Distribution",
          provisioningProfiles: { BUNDLE_ID => profile_name },
          uploadSymbols: true,
          manageAppVersionAndBuildNumber: false
        }
      )
    ensure
      File.write(pbxproj, original)
    end

    if options[:upload].to_s == "false"
      UI.success("Signed #{lane_context[SharedValues::IPA_OUTPUT_PATH]}; upload skipped")
      next
    end

    changelog = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
    changelog = "Kanaf #{version} (#{build})" if changelog.empty?
    upload_to_testflight(
      api_key: api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      changelog: changelog[0, 4000],
      uses_non_exempt_encryption: false,
      # Distributing to external groups waits for processing, then submits the build for Beta App Review.
      skip_waiting_for_build_processing: groups.empty?,
      distribute_external: !groups.empty?,
      groups: groups.empty? ? nil : groups,
      notify_external_testers: true
    )
  end
end
